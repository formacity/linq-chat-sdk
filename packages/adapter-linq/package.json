{
  "name": "@forma/linq-chat-sdk-adapter",
  "version": "0.1.0-forma.8",
  "private": true,
  "description": "Forma-maintained Linq adapter for Chat SDK",
  "keywords": [
    "adapter",
    "chat",
    "chat-sdk",
    "chatbot",
    "imessage",
    "linq",
    "sms"
  ],
  "homepage": "https://github.com/formacity/linq-chat-sdk/tree/main/packages/adapter-linq#readme",
  "bugs": {
    "url": "https://github.com/formacity/linq-chat-sdk/issues"
  },
  "license": "Apache-2.0",
  "author": "Forma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formacity/linq-chat-sdk.git",
    "directory": "packages/adapter-linq"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc --project tsconfig.json --watch",
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "openapi:check": "node scripts/check-openapi-inventory.mjs"
  },
  "dependencies": {
    "@chat-adapter/shared": "4.40.0",
    "@linqapp/sdk": "0.62.0",
    "standardwebhooks": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "5.0.0",
    "chat": "4.40.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "chat": "^4.40.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
